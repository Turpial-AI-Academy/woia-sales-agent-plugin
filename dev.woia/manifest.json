{
  "schema": "dev.woia.department-orchestrator/v1",
  "version": "0.5.8",
  "authoring_profile": "thin",
  "department": "sales",
  "execution_model": "opea-h",
  "requires_plugins": [
    {
      "name": "woia-core",
      "minimum_version": "0.5.8"
    }
  ],
  "capability_registry": "registry/capabilities.json",
  "routing_registry": "registry/routing.json",
  "shared_resources": [
    {
      "plugin": "woia-customer-data",
      "usage": "optional-organization-CRM-adapter"
    }
  ],
  "communication": [
    {
      "plugin": "woia-chatgpt-project-bridge",
      "usage": "conditional",
      "reason": "Cross-department Task request/response"
    }
  ],
  "methodology_contract": "contracts/methodology-extension.json",
  "exported_slots": [
    "subject-resolution", "qualification-policy", "follow-up-policy",
    "pipeline-transition-policy", "business-outcome-evidence"
  ],
  "allowed_delta_operations": ["ADD", "SPECIALIZE", "NARROW"],
  "inherited_gates": ["base-conformance", "delta-semantics", "authority-narrowing", "provider-closure", "update-recovery"]
}
